import numpy as np

# We create an unsorted array of 10 random integers between 0 and 100
a = np.array([69, 34, 23, 11, 5, 8, 1, 55, 42, 17])

# We implement a simple insertion sort algorithm.

def insertion_sort(arr):
    for i in range(1, len(arr)):
        key = arr[i]
        j = i - 1
        while j >= 0 and key < arr[j]:
            arr[j + 1] = arr[j]
            j -= 1
        arr[j + 1] = key
    return arr

# Now, we call the insertion sort function and print the sorted array
print("Unsorted array:", a)
print("\nSorted array:")
sorted_a = insertion_sort(a)
print(sorted_a)